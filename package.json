{
  "name": "pahamteks-final",
  "version": "1.0.0",
  "private": true,
  "description": "PahamTeks - Modern AI Platform with React, Node.js GraphQL & MySQL",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client run build",
    "init:db": "npm --prefix server run init-db",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync.ps1",
    "auto-sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/auto-sync.ps1",
    "auto-sync:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-auto-sync.ps1",
    "auto-sync:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-auto-sync.ps1 -Remove"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "engines": {
    "node": ">=20.x"
  }
}
