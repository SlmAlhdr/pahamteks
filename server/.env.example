PORT=4000
NODE_ENV=development
# Host backend lokal. Pertahankan 127.0.0.1 agar hanya komputer ini yang dapat mengaksesnya.
HOST=127.0.0.1

# APOLLO_KEY hanya diperlukan untuk publish schema dengan Rover; tidak digunakan runtime server.
# Untuk publish lokal, ekspor token sebagai environment variable APOLLO_KEY di terminal.
APOLLO_KEY=

# PORT adalah port HTTP/GraphQL. NODE_ENV gunakan development saat lokal dan production saat deployment.
# Database MySQL utama. Sesuaikan host, port, nama database, user, dan password dengan lingkungan tim.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pahamteks_db

# JWT_SECRET: buat secret acak minimal 32 karakter; generator Node.js ada di panduan fullstack.
# Server menolak berjalan jika secret kosong/pendek. Jangan gunakan secret contoh atau membagikannya.
JWT_SECRET=

# Email akun PahamTeks terverifikasi yang diberi role admin, dipisahkan koma.
# Contoh: ADMIN_EMAILS=admin1@contoh.com,admin2@contoh.com. Kosong berarti belum ada admin.
ADMIN_EMAILS=

# Password tambahan bersama untuk login admin; minimal 16 karakter acak dan hanya disimpan di .env lokal.
# Setiap admin tetap wajib memakai email allowlist dan password akun masing-masing.
# Buat password acak dengan Node.js: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# Origin frontend tambahan yang diizinkan (opsional; localhost sudah diizinkan secara default).
# Isi origin lengkap beserta protokol, pisahkan beberapa origin dengan koma.
# ALLOWED_ORIGINS=https://contoh-domain-publik.example

# Gemini: isi minimal GEMINI_API_KEY_1 untuk fitur AI. Isi _2 sampai _9 untuk rotasi cadangan.
# Alternatif satu kunci: isi GEMINI_API_KEY. Simpan nilai kunci privat, jangan commit .env.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=

# EMAIL_USER adalah alamat pengirim OTP; EMAIL_PASS adalah Gmail App Password 16 karakter atau sandi SMTP.
# Jangan gunakan password utama email dan jangan commit nilai rahasia.
EMAIL_USER=
EMAIL_PASS=
# Jika penyedia email bukan Gmail, isi konfigurasi SMTP berikut sesuai penyedia (opsional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
