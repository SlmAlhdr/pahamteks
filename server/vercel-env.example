# Isi dari integrasi TiDB Cloud atau detail koneksi cluster yang sudah digunakan.
# Gunakan cluster dan nama database yang sama agar akun/progres lama tetap tersedia.
TIDB_HOST=HOSTNAME_DARI_TIDB_CLOUD
TIDB_PORT=4000
TIDB_USER=USERNAME_DARI_TIDB_CLOUD
TIDB_PASSWORD=PASSWORD_DARI_TIDB_CLOUD
TIDB_DATABASE=NAMA_DATABASE_DARI_TIDB_CLOUD

# Hanya untuk koneksi manual memakai DB_*; TiDB_HOST otomatis memakai TLS.
# DB_SSL=true
JWT_SECRET=SECRET_ACAK_MINIMAL_32_KARAKTER
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY_1=API_KEY_GEMINI

# Opsional: dibutuhkan untuk OTP email.
EMAIL_USER=EMAIL_PENGIRIM_OTP
EMAIL_PASS=APP_PASSWORD_EMAIL
# EMAIL_FROM="PahamTeks <akun@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Opsional: akun admin.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Opsional: origin tambahan jika memakai domain kustom yang berbeda.
ALLOWED_ORIGINS=
NODE_ENV=production
