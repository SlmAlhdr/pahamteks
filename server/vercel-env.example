# TiDB Cloud Vercel integration fills these values after you connect a cluster.
# The backend accepts TIDB_* directly; use DB_* instead for other MySQL providers.
TIDB_HOST=HOSTNAME_DARI_TIDB_CLOUD
TIDB_PORT=4000
TIDB_USER=USERNAME_DARI_TIDB_CLOUD
TIDB_PASSWORD=PASSWORD_DARI_TIDB_CLOUD
TIDB_DATABASE=NAMA_DATABASE_DARI_TIDB_CLOUD

# Set this only if configuring DB_* manually and the provider requires TLS.
DB_SSL=true
JWT_SECRET=SECRET_ACAK_MINIMAL_32_KARAKTER
EMAIL_USER=EMAIL_PENGIRIM_OTP
EMAIL_PASS=APP_PASSWORD_EMAIL
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY_1=API_KEY_GEMINI
ADMIN_EMAILS=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=
