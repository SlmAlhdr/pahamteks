# ========================================================
# PahamTeks Environment Variables Template
# Salin berkas ini ke `server/.env` dan sesuaikan nilainya.
# JANGAN PERNAH menyimpan kredensial asli ke berkas ini!
# ========================================================

PORT=4000
NODE_ENV=development

# Database MySQL Configuration (Primary Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pahamteks_db

# Keamanan Autentikasi & JWT Secret (Wajib diisi string acak aman di production)
JWT_SECRET=your_jwt_secret_key_here

# Domain yang Diizinkan (Opsional, Default mengizinkan Vercel & localhost)
# ALLOWED_ORIGINS=http://localhost:5173,https://pahamteks.vercel.app

# Gemini API Keys Pool (Round-Robin Support)
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=

# Konfigurasi Pengiriman Email OTP Asli (Gmail App Password atau SMTP)
# Untuk Gmail: Masukkan email Anda dan 16-karakter App Password (Sandi Aplikasi Google)
EMAIL_USER=
EMAIL_PASS=
# Opsional custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

