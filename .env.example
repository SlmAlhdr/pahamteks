# ========================================================
# PahamTeks Environment Variables Template
# Salin berkas ini ke `server/.env` dan sesuaikan nilainya.
# JANGAN PERNAH menyimpan kredensial asli ke berkas ini!
# ========================================================

PORT=4000
NODE_ENV=development

# Database MySQL Configuration (Primary Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pahamteks_db

# Secret acak minimal 32 karakter. Server menolak berjalan jika nilai ini kosong/pendek.
JWT_SECRET=

# Email admin yang diizinkan (pisahkan dengan koma). Kosong berarti belum ada admin.
ADMIN_EMAILS=

# Domain tambahan yang diizinkan (opsional; localhost sudah diizinkan secara default)
# ALLOWED_ORIGINS=https://contoh-domain-publik.example

# Gemini API Keys Pool (Round-Robin Support)
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=

# Konfigurasi Pengiriman Email OTP Asli (Gmail App Password atau SMTP)
# Untuk Gmail: Masukkan email Anda dan 16-karakter App Password (Sandi Aplikasi Google)
EMAIL_USER=
EMAIL_PASS=
# Opsional custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
