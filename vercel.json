{
  "version": 2,
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/graphql", "destination": "/api/graphql.js" },
    { "source": "/health", "destination": "/api/graphql.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
